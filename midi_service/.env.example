# midi_service — copy to midi_service/.env for local overrides (optional).
# Compose reads root .env for MIDI_SERVICE_API_TOKEN, MIDI_DEVICE, etc.

# Directory where converted MIDI files are written (default: ../tmp/midi)
MIDI_OUTPUT_DIR=../tmp/midi

# Shared secret the Express backend sends via X-Midi-Service-Token header.
# Leave blank to disable auth (local dev only).
MIDI_SERVICE_API_TOKEN=

# Maximum upload file size in megabytes (default: 100)
MIDI_MAX_UPLOAD_MB=100

# Maximum number of queued conversion jobs before rejecting new requests (default: 8)
MIDI_MAX_QUEUE_DEPTH=8

# CPU-only server (no GPU). Non-cpu values are logged and ignored.
MIDI_DEVICE=cpu

# Comma-separated list of allowed CORS origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
