# Root .env for docker-compose. Copy to .env and fill in real values.
# NEVER commit .env — only .env.example (with placeholders) belongs in git.
# Individual services also have their own .env.example files.

# ── Frontend (Vite build args) ────────────────────────────────────────────────
# Clerk publishable key — safe to expose in frontend. Get from:
# https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Backend API base URL baked into the Vite bundle (what the *browser* calls).
# - Docker Compose + nginx on one host: leave unset or empty so the app uses window.location.origin
#   and hits /api/... on the same origin (see frontend/nginx.conf → backend).
# - Split API host (e.g. api.example.com): set https://api.example.com
# - Local dev: http://localhost:3001
# Never use http://backend:3001 — that name exists only inside Docker and breaks in the browser.
VITE_API_BASE_URL=

# Optional: Google Analytics 4 measurement ID (G-xxxxxxxxxx). Required at *build* time for Docker;
# add here and rebuild the frontend image. Local dev: also set in frontend/.env.
# VITE_GA_MEASUREMENT_ID=

# Stripe publishable key — safe to expose in frontend. Get from:
# https://dashboard.stripe.com → Developers → API Keys
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe pricing table ID (Dashboard → Product catalog → Pricing tables)
# VITE_STRIPE_PRICING_TABLE_ID=prctbl_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe package pricing table ID (for single-song / top-up packages)
# VITE_STRIPE_PACKAGE_PRICING_TABLE_ID=prctbl_xxxxxxxxxxxxxxxxxxxxxxxx

# Full external pricing page URL (opened from in-app header button)
# VITE_FULL_PRICING_URL=https://www.burntbeats.com/pricing

# ── Backend ───────────────────────────────────────────────────────────────────
# Public site origin (no trailing slash). Preferred in production: overrides getBaseUrl() so stem/MIDI/speech
# file URLs in API JSON are always https:// (fixes mixed-content when nginx uses $scheme on an internal HTTP hop).
# If unset, backend uses X-Forwarded-Proto then req.protocol — nginx must send X-Forwarded-Proto: https when TLS
# terminates at the proxy; otherwise set this explicitly (docker-compose passes it into the backend container).
# PUBLIC_BASE_URL=https://www.burntbeats.com

# Optional: extra CORS + Stripe returnUrl origins (comma-separated). Built-in defaults include
# https://burntbeats.com, https://www.burntbeats.com, and common localhost URLs — see backend/allowedOrigins.js.
# FRONTEND_ORIGINS=https://staging.example.com

# Optional: require x-api-key on API routes (server-only; never put in VITE_*).
API_KEY=

# Required in production: sign per-job tokens (status/file download auth).
JOB_TOKEN_SECRET=

# Internal service-to-service API tokens (min 16 chars). Required when NODE_ENV=production
# unless you override INTERNAL_SERVICE_AUTH_REQUIRED=0 (not recommended).
# Generate: openssl rand -base64 32
STEM_SERVICE_API_TOKEN=
SPEECH_SERVICE_API_TOKEN=
MIDI_SERVICE_API_TOKEN=
# Force token requirement outside production (optional). docker-compose sets
# INTERNAL_SERVICE_AUTH_REQUIRED=1 on speech_service and midi_service workers.
# INTERNAL_SERVICE_AUTH_REQUIRED=1
# Backend-side timeout for waiting on the MIDI service to accept a conversion job (milliseconds).
MIDI_ACCEPT_TIMEOUT_MS=60000
# Token debit for POST /api/midi/convert (audio-to-MIDI). Default 1 when unset.
# MIDI_TOKEN_COST=1
# Token debit for POST /api/midi/render (MIDI-to-audio). Default 2 when unset.
# MIDI_RENDER_TOKEN_COST=2
# Optional MIDI queue depth for the midi_service worker.
MIDI_MAX_QUEUE_DEPTH=8
# Dev-only auth bypass for upload/expand metering/auth checks. Keep 0 in production.
DEV_BYPASS_UPLOAD_AUTH=0

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# SECRET — never expose this in the frontend or commit the real value.
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Webhook signing secret — Clerk Dashboard → Webhooks → your endpoint → Signing Secret (whsec_...).
# Endpoint URL (same origin as the app): https://YOUR_DOMAIN/api/clerk/webhook
# Required in Docker/production if you use welcome signup tokens (user.created).
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ── Stripe (payments) ─────────────────────────────────────────────────────────
# SECRET — never expose in the frontend or commit the real value.
# Prefer a restricted key (rk_live_ / rk_test_) with least privilege in production.
# Full secret keys (sk_live_ / sk_test_) also work via STRIPE_SECRET_KEY.
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=your_stripe_secret_or_restricted_key_here

# Webhook signing secret — Dashboard (prod) or Stripe CLI (local). Local: stripe login, then
#   bash scripts/stripe-listen.sh   (or: cd backend && npm run stripe:listen)
# Paste the printed whsec_... here.
# Endpoint URL (same origin as the app): https://YOUR_DOMAIN/api/billing/webhook
# Subscribe to: checkout.session.completed, customer.subscription.*, invoice.payment_succeeded
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe account ID — not currently read by backend code (Dashboard reference only).
# STRIPE_ACCOUNT_ID=acct_xxxxxxxxxxxx

# ── Stripe price / product IDs ────────────────────────────────────────────────
# Create products at https://dashboard.stripe.com → Products

# Studio Quality Plan ($25/mo, 800 tokens/mo metadata)
STRIPE_PRICE_ID_STUDIO=price_1T9sekP38C54URjEATva0Siw
STRIPE_PRODUCT_ID_STUDIO=prod_U88wXQIVJd9fFy

# Premium Monthly ($15/mo)
STRIPE_PRICE_ID_PREMIUM=price_1T9sY3P38C54URjEQ9XHdBqm
STRIPE_PRODUCT_ID_PREMIUM=prod_U88pCAQVpNCMiK

# Basic Monthly ($9/mo)
STRIPE_PRICE_ID_BASIC=price_1T9sQhP38C54URjE0Va7eUYl
STRIPE_PRODUCT_ID_BASIC=prod_U88iFWizJYpJr6

# Top-Up Pack ($5, entitlement_tier=premium in price metadata)
STRIPE_PRICE_ID_TOPUP=price_1T9sidP38C54URjEIcLojWrf
STRIPE_PRODUCT_ID_TOPUP=prod_U890T5sguJrCZ4

# Single Song Pack — one-time $0.99 purchase (mode: "payment", not subscription)
STRIPE_PRICE_ID_SINGLE=price_1TQmdCP38C54URjE5VEClCWA

# Annual subscription prices ($86 / $144 / $240 per year)
STRIPE_PRICE_ID_BASIC_ANNUAL=price_1TiGaXP38C54URjEAPICkpCt
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_1TiGafP38C54URjE50Sg0dhW
STRIPE_PRICE_ID_STUDIO_ANNUAL=price_1TiGafP38C54URjEbF2CwBCT

# ── Stripe Dashboard copy & metadata (manual — reduces refund disputes) ───────
# Basic product: "Speed-mode 2-stem split. 4-stem and Quality modes require Premium."
# Premium product: "Full workstation — 4-stem, quality, batch, mixer, export."
# Top-Up price metadata: tokens_per_topup=60, entitlement_tier=premium
# Single price metadata: tokens_per_topup=4 (or tokens_per_topup), entitlement_tier=basic
# Studio monthly metadata: tokens_per_month=800 (price anchor tier)
# Enable Smart Retries + automatic card updater in Stripe Billing settings

# Welcome signup grant (minutes). Default in code if unset: 10
USAGE_SIGNUP_WELCOME_TOKENS=10

# Free monthly allowance for signed-in users without paid balance (minutes, no rollover)
FREE_MONTHLY_ALLOWANCE_MINUTES=5

# Retention coupon ID in Stripe (25% off 3 months, cancel-flow save offer)
STRIPE_RETENTION_COUPON_ID=ZnoX3alj

# Feature flags for staged rollout
# ANNUAL_BILLING_ENABLED=1
# CANCEL_FLOW_ENABLED=1
# FREE_MONTHLY_ALLOWANCE_ENABLED=1

# Disable legacy 60s sample mode (removed from product — use free allowance instead)
SAMPLE_MODE_ENABLED=0

# ── Sentry APM (error tracking + performance monitoring) ──────────────────────
# Each service uses its own DSN (Sentry project). Leave unset to disable monitoring (graceful degradation).
# Get DSNs from: https://sentry.io → Settings → Projects → Client Keys (DSN)

# Backend Sentry DSN (Node.js/Express project)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Stem service Sentry DSN (Python/FastAPI project — separate from backend)
# SENTRY_DSN_STEM=https://examplePublicKey@o0.ingest.sentry.io/1

# Frontend Sentry DSN (React project — baked into the Vite bundle at build time)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/2

# Environment tag for all services (production, staging, development). Default: production.
# SENTRY_ENVIRONMENT=production

# Frontend environment override (uses SENTRY_ENVIRONMENT if unset). Baked in at build time.
# VITE_SENTRY_ENVIRONMENT=production

# Release tag — typically the git SHA or version tag. Correlates errors with deployments.
# SENTRY_RELEASE=

# Frontend release override (uses SENTRY_RELEASE if unset). Baked in at build time.
# VITE_SENTRY_RELEASE=

# Source map upload credentials (required at frontend build time for readable stack traces).
# Get from: https://sentry.io → Settings → Auth Tokens
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-frontend-project
