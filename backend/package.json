{
  "name": "burntbeats-backend",
  "version": "1.0.0",
  "description": "API proxy for stem-splitting service: uploads, job status, stem file serving, cleanup.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "db:migrate": "node --env-file=.env db-migrate.js",
    "catalog:generate": "node scripts/generate-midi-catalog.mjs",
    "catalog:health": "node scripts/catalog-health.mjs",
    "stripe:listen": "node --env-file=.env ../scripts/stripe-local-dev.mjs",
    "test": "node --test",
    "test:assertions": "node check-test-assertions.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/express": "^2.1.11",
    "@sentry/node": "^10.53.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.0.0",
    "nodemailer": "^8.0.9",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "stripe": "^20.4.1",
    "svix": "^1.92.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "fast-check": "4.8.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "vitest": "4.1.8"
  },
  "overrides": {
    "js-cookie": "^3.0.7",
    "qs": "^6.15.2",
    "js-yaml": "^4.1.2"
  }
}
