# speech_service — copy to speech_service/.env for local overrides (optional).
# Compose reads root .env for SPEECH_SERVICE_API_TOKEN, SPEECH_DEVICE, etc.

SPEECH_MODELS_DIR=../speech_models
SPEECH_OUTPUT_DIR=../tmp/speech
SPEECH_DEVICE=cpu
# Must match backend SPEECH_MAX_UPLOAD_MB and frontend VITE_SPEECH_MAX_UPLOAD_BYTES.
SPEECH_MAX_UPLOAD_MB=100
SPEECH_MAX_QUEUE_DEPTH=8
