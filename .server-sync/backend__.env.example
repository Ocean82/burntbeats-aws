# Backend API env (optional). Copy to .env and set for server deployment.
# run-backend.sh sources backend/.env if present so PORT etc. match your security groups.
# Use these ports to align with EC2 security group (e.g. 8001) instead of changing the server.

# Port the backend listens on (default 3001). Set to 8001 to match server security group.
PORT=3001

# Public origin for stem file URLs in JSON (https://yourdomain.com). No trailing slash.
# Use when reverse proxies omit or mis-set X-Forwarded-Proto (mixed content on stem WAV URLs).
# PUBLIC_BASE_URL=https://burntbeats.com

# Stem service URL (default http://127.0.0.1:5000). Same host: 127.0.0.1:5000.
STEM_SERVICE_URL=http://127.0.0.1:5000

# Dir for stem output (must match stem service STEM_OUTPUT_DIR). Default: repo root tmp/stems
# STEM_OUTPUT_DIR=/path/to/burntbeats-aws/tmp/stems

# Speech service URL (default http://127.0.0.1:5001). Same host: 127.0.0.1:5001.
SPEECH_SERVICE_URL=http://127.0.0.1:5001

# Dir for speech output (must match speech_service SPEECH_OUTPUT_DIR). Default: repo root tmp/speech
# SPEECH_OUTPUT_DIR=/path/to/burntbeats-aws/tmp/speech

# MIDI service URL (default http://127.0.0.1:5002). Compose uses http://midi_service:5002 inside the network.
MIDI_SERVICE_URL=http://127.0.0.1:5002

# Dir for MIDI output (must match midi_service MIDI_OUTPUT_DIR). Default: repo root tmp/midi
# MIDI_OUTPUT_DIR=/path/to/burntbeats-aws/tmp/midi

# Time (ms) to wait for speech service to accept the enhance request (default 300000 = 5 min)
# SPEECH_ACCEPT_TIMEOUT_MS=300000

# Token for protecting the Python speech service when reachable outside a trusted network.
# Must match SPEECH_SERVICE_API_TOKEN in speech_service.
# SPEECH_SERVICE_API_TOKEN=

# Default maxAgeHours for POST /api/stems/cleanup when query param omitted (cron TTL). Default 24.
# STEM_CLEANUP_DEFAULT_MAX_AGE_HOURS=24

# Optional server-side master WAV (Python stem_service/server_export.py). Token-metered like split when enabled.
# SERVER_EXPORT_ENABLED=0

# Time (ms) to wait for stem service to accept the split request (default 300000 = 5 min)
# SPLIT_ACCEPT_TIMEOUT_MS=300000

# Max upload size for POST /api/stems/split (bytes). Default 524288000 (500MB). Lower to reduce DoS risk.
# MAX_UPLOAD_BYTES=52428800

# Extra CORS + Stripe returnUrl origins (comma-separated). Defaults always include https://burntbeats.com
# and https://www.burntbeats.com plus common localhost ports (see allowedOrigins.js).
# FRONTEND_ORIGINS=https://staging.example.com

# Optional malware scan (ClamAV) before split ΓÇö upload stays in isolated temp; scan runs before stem_service.
# Install: Ubuntu `apt install clamav` then `freshclam`. Production: prefer `clamdscan` + clamd for speed.
# MALWARE_SCAN_ENABLED=1
# CLAMSCAN_BIN=clamdscan
# CLAMSCAN_ARGS=
# MALWARE_SCAN_TIMEOUT_MS=120000
# Append file path as last arg (default true). Set false only for custom scanner wrappers in tests.
# MALWARE_SCAN_APPEND_PATH=true

# Optional API key for /api/stems/split (leave unset for no auth)
# API_KEY=

# Debug only: forward raw upstream error text in JSON responses (never enable in production).
# EXPOSE_UPSTREAM_ERROR_DETAILS=

# Optional API key for per-job request auth
# - The backend uses this to sign short-lived access tokens returned to the frontend.
# - Leave unset/empty to disable token enforcement (dev/local only).
# JOB_TOKEN_SECRET=
# JOB_TOKEN_TTL_MS=3600000

# Token for protecting the Python stem service when reachable outside a trusted network.
# This must be set to the same value in stem_service and backend.
# STEM_SERVICE_API_TOKEN=

# Optional Redis ΓÇö shared webhook idempotency + per-period credit locks (multi-instance API).
# Same URL can be used for rate limiting if you add that later.
# REDIS_URL=redis://localhost:6379
# STRIPE_WEBHOOK_REDIS_URL=redis://localhost:6379

# Optional Redis-backed rate limiting (falls back to in-memory if unset).
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=10
# Note: GET /api/stems/status/:job_id is excluded from this global cap (split polling ~40/min).

# Optional: override accept timeout for expand (defaults to SPLIT_ACCEPT_TIMEOUT_MS).
# EXPAND_ACCEPT_TIMEOUT_MS=

# S3: stem_service uploads WAVs after each job; backend presigns GET /api/stems/file ΓåÆ redirect to S3.
# Configure the same bucket/region on stem_service and backend. Use IAM role or keys below.
# S3_ENABLED=true
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_PREFIX=stems
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional: remove local stems after upload (backend must presign ΓÇö needs AWS creds). Default false.
# S3_DELETE_LOCAL_AFTER_UPLOAD=false
# Presigned URL TTL for stem GET (seconds). Default 3600.
# S3_PRESIGN_EXPIRES_SECONDS=3600

# ΓöÇΓöÇ Usage tokens (split/expand debit) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
# 1 token = 1 minute of audio (partial minutes round up). E.g. 5:00 ΓåÆ 5 tokens.
# When enabled, POST /api/stems/split and /expand require Authorization: Bearer (Clerk JWT).
# USAGE_TOKENS_ENABLED=1
# USAGE_TOKENS_DEV_UNLIMITED=1
# Production safety guard: backend exits if metering is disabled unless this is explicitly true.
# Keep unset/false in production to avoid accidental unmetered access.
# ALLOW_UNMETERED_PROD=0
# Monthly grant (Stripe Price metadata tokens_per_month, or this default) ΓÇö same token unit (minutes).
# USAGE_DEFAULT_TOKENS_PER_MONTH=6000
# One-time welcome grant applied when Clerk sends user.created webhook.
# USAGE_SIGNUP_WELCOME_TOKENS=5

# Legal acceptance ΓÇö must match frontend/src/legal/versions.ts ΓåÆ LEGAL_VERSIONS (LegalAcceptanceGate / POST /api/legal/accept)
# LEGAL_TOS_VERSION=2026-05
# LEGAL_PRIVACY_VERSION=2026-05

# ΓöÇΓöÇ PostgreSQL (AWS RDS) ΓÇö backend/db.js ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
# Connection string for the RDS PostgreSQL instance. Unset = DB features disabled (Clerk-only fallback).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=5000
# DB_MAX_USES=7500
# DB_QUERY_TIMEOUT=30000
# DB_STATEMENT_TIMEOUT=30000

# ΓöÇΓöÇ Clerk (auth) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
# Required for JWT verification. Get from https://dashboard.clerk.com ΓåÆ API Keys.
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Clerk webhook signing secret (Dashboard ΓåÆ Webhooks endpoint signing secret).
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ΓöÇΓöÇ Stripe (payments) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
# Plan model (Basic vs Premium, monthly tokens, duration-based usage): docs/BILLING-AND-TOKENS.md
# Optional Price metadata: tokens_per_month, token_seconds_per_month, allow_4stem (see doc).
# Inspect prices: stripe prices retrieve price_xxx
#
# Local / safe testing: turn ON "Test mode" in the Stripe Dashboard (top right), then use
# sk_test_... and STRIPE_PRICE_ID_* values that exist in TEST mode only. Your frontend must use
# pk_test_... (VITE_STRIPE_PUBLISHABLE_KEY). Mixing live keys with test prices (or the reverse)
# makes checkout fail with Stripe API errors.
#
# Required for billing. Get from https://dashboard.stripe.com ΓåÆ Developers ΓåÆ API Keys.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Webhook signing secret ΓÇö local dev: `stripe login`, then from repo root `bash scripts/stripe-listen.sh`
# or from backend/ `npm run stripe:listen`. Copy the CLIΓÇÖs whsec_... here.
# Production: Dashboard ΓåÆ Webhooks ΓåÆ endpoint signing secret.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Stripe account ID ΓÇö from https://dashboard.stripe.com ΓåÆ Settings ΓåÆ Account details
STRIPE_ACCOUNT_ID=acct_xxxxxxxxxxxx

# Stripe price IDs ΓÇö create products at https://dashboard.stripe.com ΓåÆ Products
STRIPE_PRICE_ID_BASIC=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ID_BASIC=prod_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PREMIUM=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ID_PREMIUM=prod_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_STUDIO=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ID_STUDIO=prod_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_TOPUP=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ID_TOPUP=prod_xxxxxxxxxxxxxxxxxxxx
# Single Song Pack ΓÇö one-time $0.99 purchase (mode: "payment", not subscription)
STRIPE_PRICE_ID_SINGLE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ΓöÇΓöÇ Sentry APM (error tracking + performance monitoring) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
# DSN for the backend Sentry project. Leave unset to disable monitoring (graceful degradation).
# Get from: https://sentry.io ΓåÆ Settings ΓåÆ Projects ΓåÆ Client Keys (DSN)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Environment tag (production, staging, development). Default: uses NODE_ENV.
# SENTRY_ENVIRONMENT=production

# Release tag ΓÇö typically the git SHA or version tag. Correlates errors with deployments.
# SENTRY_RELEASE=
